# Sanity (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=swb3duug
NEXT_PUBLIC_SANITY_DATASET=production

# Optional
# NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Viewer token for draft mode / Visual Editing (sanity.io/manage > API > Tokens).
# Not needed to read published content.
# SANITY_API_READ_TOKEN=

# Better Auth
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. Passkeys are bound to its hostname.
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string (Neon: use the pooled connection string).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
