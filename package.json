{
  "name": "workstart",
  "version": "0.7.0",
  "private": true,
  "author": {
    "name": "EliasPereyra",
    "url": "https://github.com/EliasPereyra"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasPereyra/job-platform.git"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @workstart/web --filter @workstart/studio dev",
    "dev:web": "pnpm --filter @workstart/web dev",
    "dev:studio": "pnpm --filter @workstart/studio dev",
    "build": "pnpm --filter @workstart/web build",
    "lint": "pnpm --filter @workstart/web lint",
    "test": "pnpm --filter @workstart/web test",
    "typegen": "pnpm --filter @workstart/studio typegen",
    "seed": "pnpm --filter @workstart/studio seed"
  },
  "packageManager": "pnpm@12.6.0"
}
